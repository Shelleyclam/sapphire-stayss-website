# Sapphire Stayss: settings for the GoDaddy cPanel (Apache) hosting

ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Always use https and the bare domain.
  # The site sits behind Cloudflare, which talks to this server and passes the visitor's
  # protocol in X-Forwarded-Proto. Checking %{HTTPS} here would cause a redirect loop.
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://sapphirestayss.in%{REQUEST_URI} [L,R=301]
</IfModule>

# Old website addresses, sent to their new pages (keeps Google links working)
Redirect 301 "/html pages/stayss.html" https://sapphirestayss.in/rooms.html
Redirect 301 "/html pages/gallery.html" https://sapphirestayss.in/gallery.html
Redirect 301 "/html pages/see and do.html" https://sapphirestayss.in/explore.html
Redirect 301 "/html pages/Contact.html" https://sapphirestayss.in/contact.html
Redirect 301 "/html pages/room-1.html" https://sapphirestayss.in/rooms/deluxe-villa.html
Redirect 301 "/html pages/room2.html" https://sapphirestayss.in/rooms/family-room-garden-view.html
Redirect 301 "/html pages/room3.html" https://sapphirestayss.in/rooms/deluxe-family-suite.html
Redirect 301 "/html pages/room4.html" https://sapphirestayss.in/rooms/double-room-mountain-view.html
Redirect 301 "/html pages/room5.html" https://sapphirestayss.in/rooms/double-or-twin-room.html
Redirect 301 "/html pages/room6.html" https://sapphirestayss.in/rooms/king-room-mountain-view.html
Redirect 301 /policies.html https://sapphirestayss.in/faq.html
Redirect 301 /Contact.html https://sapphirestayss.in/contact.html

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

AddType image/webp .webp
